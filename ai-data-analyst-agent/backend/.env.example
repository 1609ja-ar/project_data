# ---------- Application ----------
# development | test | production. Production enables Secure cookies and hides /api/docs.
APP_ENV=development
# In production the server refuses to start until CORS_ORIGINS/FRONTEND_URL are https, ALLOWED_HOSTS is set,
# and MONGODB_URI has a login (plus TLS for a remote database). See docs/SECURITY.md.
# Host names this API answers for, comma-separated (e.g. api.example.com). Empty = any (development only).
ALLOWED_HOSTS=
# Public URL of the frontend (used in password-reset links).
FRONTEND_URL=http://localhost:5173
# Comma-separated CORS allow-list (production). In development Vite proxies /api, so CORS is not needed.
CORS_ORIGINS=http://localhost:5173

# ---------- Security ----------
# Sign-in uses one HttpOnly session cookie with a random ID; sessions are stored server-side (hashed).
# A session ends after SESSION_IDLE_DAYS without use, and in any case after SESSION_MAX_DAYS.
# (JWT_SECRET, ACCESS_TOKEN_MINUTES and REFRESH_TOKEN_DAYS are no longer used and can be removed from .env.)
SESSION_IDLE_DAYS=7
SESSION_MAX_DAYS=30
# Leave empty to use Secure cookies only in production; set true/false to override.
COOKIE_SECURE=
PASSWORD_RESET_MINUTES=30

# ---------- MongoDB (local or Atlas) ----------
# Production: connect as a user that has only the readWrite role on MONGODB_DB, over TLS, e.g.
# mongodb+srv://<app-user>:<password>@<cluster-host>/   (put the real value only in backend/.env)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=ai_data_analyst

# ---------- Currency ----------
# Money columns whose values have no currency symbol/code are treated as this currency (INR = Indian rupee, ₹).
# Values written with a symbol keep it ($ = USD, ₹/Rs/INR = INR, ...). Amounts are never converted.
DEFAULT_CURRENCY=INR

# ---------- Storage and upload limits ----------
# Relative paths are resolved from the backend/ folder. Never serve this folder statically.
STORAGE_DIR=storage
# Tested: 30 lakh rows (156 MB CSV) cleans in ~4 min in the background using ~3.5 GB of memory.
# Allow about 1.2 GB of server memory per 10 lakh rows (two files can be cleaned at the same time).
MAX_UPLOAD_MB=150
# Excel is read much more slowly than CSV; 40 MB covers Excel's own limit of 10,48,576 rows.
MAX_EXCEL_MB=40
MAX_ROWS=3000000
MAX_COLUMNS=500

# ---------- Analytics / SQL Workbench ----------
QUERY_TIMEOUT_SECONDS=20
SQL_TIMEOUT_SECONDS=10
SQL_MAX_ROWS=10000
SQL_MEMORY_LIMIT=512MB

# ---------- Power BI live feed ----------
EXPORT_TOKEN_MAX_DAYS=90
# Allow ?token= in feed URLs. Default false because URLs end up in logs.
EXPORT_TOKEN_IN_URL=false

# ---------- Email (password reset). Leave SMTP_HOST empty to disable. ----------
# In development without SMTP, reset links are printed to the backend console only.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# ---------- AI providers (optional; only configured ones appear in Settings) ----------
# Default provider when a user has not chosen one: groq | xai | (empty)
AI_PROVIDER=
# Groq (groq.com) - keys start with gsk_
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
# xAI Grok (x.ai). Uses the OpenAI-compatible /chat/completions endpoint, which xAI labels "legacy" (Responses API is primary).
XAI_API_KEY=
XAI_MODEL=grok-4.7
XAI_BASE_URL=https://api.x.ai/v1
AI_TIMEOUT_SECONDS=45

# ---------- Rate limits ----------
SIGNIN_RATE_LIMIT=10/minute
SIGNUP_RATE_LIMIT=5/minute
FEED_RATE_LIMIT=60/minute
# Every API request, per IP
API_RATE_LIMIT=300/minute
# Per signed-in user: AI calls, uploads/URL imports/refreshes, SQL Workbench runs
AI_RATE_LIMIT=20/minute
UPLOAD_RATE_LIMIT=20/hour
SQL_RATE_LIMIT=60/minute
# Empty = in memory (correct for one backend process). Several processes/servers: redis://host:6379/0 (pip install redis)
RATE_LIMIT_STORAGE_URI=
